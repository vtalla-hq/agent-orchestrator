# anthropic (default, Claude) or groq
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium
# only with LLM_PROVIDER=groq
GROQ_API_KEY=
AI_BASE_URL=https://api.groq.com/openai/v1
# Pick a model Spotter's Ask doesn't use (it uses gpt-oss-120b, falling back to gpt-oss-20b): Groq's free
# tier caps tokens per model per day, and one long library run used up Ask's 200k for gpt-oss-120b
AI_MODEL=qwen/qwen3.8-27b
REDIS_URL=redis://localhost:6379/0
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/orchestrator
NCBI_API_KEY=
# Where approved save_to_library calls go: local (this Postgres only, default) or spotter
LIBRARY_TARGET=local
# only with LIBRARY_TARGET=spotter: Spotter's Supabase project (service key, never commit it)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
